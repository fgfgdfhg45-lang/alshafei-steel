rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'alshafystyl@gmail.com';
    }
    match /orders/{orderId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read:   if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());
      allow update: if isAdmin()
                    || (request.auth != null
                        && request.auth.uid == resource.data.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status','cancelReason','canceledAt','canceledByUser'])
                        // التعديل الوحيد عن قواعدك: سمحت كمان بـ "ملغي تلقائياً"
                        // (الموقع بيلغي الطلب بعد 48 ساعة بالقيمة دي)
                        && request.resource.data.status in ['ملغي', 'ملغي تلقائياً']);
      allow delete: if isAdmin();
    }
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }
    match /machines_new/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /machine_overrides/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /site_settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /quotes_archive/{docId} {
      allow read, write: if isAdmin();
    }
    match /saved_machines/{docId} {
      allow read, write: if isAdmin();
    }
    match /contracts/{docId} {
      allow read, write: if isAdmin();
    }

    // تطبيق الرواتب: للأدمن بس — استخدم النسخة دي بعد ما تطبيق الرواتب يبقى بيسجل دخول بحساب الأدمن
    match /payroll_app/{doc} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
